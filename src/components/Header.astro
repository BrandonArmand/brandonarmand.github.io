---
import space from '../assets/space.webp';
import SkillList from './SkillList.astro';
---

<div class="col-header" id="header">
  <div class="space-2" style={`background-image: url(${space.src})`}></div>
  <h2 class="display-4" id="name">
    <span class="text-green">B</span><span class="name-rest">randon</span>
    <span class="text-orange">A</span><span class="name-rest">rmand</span>
    <span class="text-blue">W</span><span class="name-rest">elsh</span>
  </h2>
  <div id="pic">
    <h4 class="display-4 pic-tag">experienced</h4>
    <h4 class="display-4 pic-title">Software Engineer</h4>
  </div>
  <SkillList />
</div>
