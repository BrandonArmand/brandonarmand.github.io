---
import space from '../assets/space.webp';
import { LOCATION } from '../config';
import SkillList from './SkillList.astro';
---

<div class="col-header" id="header" transition:persist>
  <div class="side-top">
    <img class="side-space" src={space.src} width={space.width} height={space.height} alt="" />
    <h1 id="name">
      <span class="name-initial text-green">B</span>randon
      <span class="name-initial text-orange">A</span>rmand
      <span class="name-initial text-blue">W</span>elsh
    </h1>
    <p class="side-role">
      <span class="role-text">Software Engineer<span class="role-badge">7yrs</span></span>
    </p>
    <p class="side-meta">{LOCATION} &middot; DraftKings &middot; ex-Meta</p>
  </div>
  <div class="tray">
    <span class="tray-label">~/skills</span>
    <SkillList />
  </div>
  <div class="side-foot">
    <button class="next-screen" type="button" data-next-screen>
      <span>Terminal</span>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
    </button>
  </div>
</div>
