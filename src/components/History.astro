---
import { duration, stints } from '../data/history';
---

<div class="desk desk-history">
  <div class="window-slot"><section class="files-window" id="history-window" data-window data-tile="/history" aria-label="History">
    <div class="toolbar" id="toolbar">
      <button class="red" type="button" aria-label="Close window"></button>
      <button class="yellow" type="button" aria-label="Minimize window to the dock"></button>
      <button class="green" type="button" aria-label="Zoom window"></button>
      <span class="window-title">~/history</span>
    </div>
    <div class="history-body">
      <div class="history-head">
        <h2>History</h2>
        <button class="sort-chip" type="button" disabled>
          <span class="sort-label">Sort</span>Newest first
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
      </div>
      <ol class="timeline">
        {
          stints.map((stint) => (
            <li class="stint" style={`--bar: ${stint.colors.length > 1 ? `linear-gradient(to bottom, ${stint.colors[0]} 0%, ${stint.colors[stint.colors.length - 1]} 45%)` : stint.colors[0]}`}>
              <div class="stint-time">
                <span class="time-num">{stint.years}</span>
                <span class="time-unit">{stint.years === 1 ? 'year' : 'years'}</span>
              </div>
              <div class="stint-bar" aria-hidden="true"></div>
              <div class="stint-cards">
                {
                  stint.companies.map((company) => (
                    <div class="company-card">
                      <div class="company-head">
                        <h3>{company.name}</h3>
                        {
                          company.badges.map((badge) => (
                            <span class="badge" style={`background: ${badge.background}; border-color: ${badge.border}; color: ${badge.color}`}>
                              {badge.label}
                            </span>
                          ))
                        }
                        <span class="company-total">{duration(company.years)} in total</span>
                      </div>
                      <ul class="role-list">
                        {
                          company.roles.map((role) => (
                            <li class="role">
                              <span class="role-title">{role.title}</span>
                              <span class="role-length">{role.current ? 'current' : duration(role.years)}</span>
                            </li>
                          ))
                        }
                      </ul>
                    </div>
                  ))
                }
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  </div>
</div>