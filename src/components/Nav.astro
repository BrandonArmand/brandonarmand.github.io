---
import { GITHUB_URL, LINKEDIN_URL, MAILTO, ROUTES } from '../config';

const current = Astro.url.pathname.replace(/\/$/, '') || ROUTES.home;

const links = [
  { label: 'About', href: ROUTES.home },
  { label: 'Projects', href: ROUTES.projects },
];
---

<nav class="navbar">
  <ul class="navbar-nav">
    {
      links.map(({ label, href }) => (
        <li>
          <a class="nav-link" href={href} aria-current={href === current ? 'page' : undefined}>{label}</a>
        </li>
      ))
    }
  </ul>
  <div class="navbar-links">
    <a class="navbar-brand" href={LINKEDIN_URL} target="_blank" rel="noopener" aria-label="LinkedIn">
      <i class="fa-brands fa-linkedin"></i>
    </a>
    <a class="navbar-brand" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="GitHub">
      <i class="fa-brands fa-github"></i>
    </a>
    <a class="navbar-brand" href={MAILTO}>Contact</a>
  </div>
</nav>
