---
import brandsFont from '@fortawesome/fontawesome-free/webfonts/fa-brands-400.woff2?url';
import monoFont from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import space from '../assets/space.webp';
---

<link rel="preload" as="font" type="font/woff2" href={brandsFont} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={monoFont} crossorigin />
<link rel="preload" as="image" href={space.src} />
