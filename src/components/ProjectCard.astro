---
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  tech: string;
  href: string;
  image: ImageMetadata;
}

const { title, tech, href, image } = Astro.props;
const bg = await getImage({ src: image, format: 'webp', width: 1200 });
---

<a class="project-card" href={href} target="_blank" rel="noopener" style={`background-image: url(${bg.src})`}>
  <h2 class="description display-4">{tech}</h2>
  <h1 class="description display-4">{title}</h1>
</a>
