---
import { getImage } from 'astro:assets';
import { fetchRepoStats } from '../data/github';
import { projects } from '../data/projects';

const entries = await Promise.all(
  projects.map(async (project) => {
    const live = project.repo ? await fetchRepoStats(project.repo) : {};
    return {
      project,
      stats: project.stats?.map((stat) => ({ ...stat, value: live[stat.key] ?? stat.value })),
      thumb: await getImage({ src: project.image, format: 'webp', width: 140 }),
      banner: await getImage({ src: project.image, format: 'webp', width: 1400 }),
    };
  })
);
const [first] = projects;
---

<div class="desk desk-projects">
  <div class="window-slot"><section class="files-window" id="project-window" data-window data-tile="/projects" aria-label="Projects">
    <div class="toolbar" id="toolbar">
      <button class="red" type="button" aria-label="Close window"></button>
      <button class="yellow" type="button" aria-label="Minimize window to the dock"></button>
      <button class="green" type="button" aria-label="Zoom window"></button>
      <span class="window-title">~/projects</span>
    </div>
    <div class="files-body">
      <ul class="project-list">
        {
          entries.map(({ project, thumb }, index) => (
            <li>
              <button class="project-row" type="button" data-project={project.id} aria-pressed={index === 0 ? 'true' : 'false'}>
                <img src={thumb.src} width="66" height="46" alt="" loading="lazy" />
                <span class="project-row-text">
                  <span class="project-row-title">{project.title}</span>
                  <span class="project-row-meta">
                    <span class="project-row-stack">{project.stack.join(', ')}</span>
                    <span class="project-year">{project.year}</span>
                  </span>
                </span>
              </button>
            </li>
          ))
        }
        <li class="more-row">
          <a href="https://github.com/BrandonArmand" target="_blank" rel="noopener">More on GitHub &#8599;</a>
        </li>
      </ul>
      <div class="project-previews">
        {
          entries.map(({ project, banner, stats }, index) => (
            <article class="project-preview" data-preview={project.id} data-title={project.title} hidden={index !== 0}>
              <a class="preview-shot" href={project.liveUrl ?? project.repoUrl} target="_blank" rel="noopener">
                <img src={banner.src} width={banner.attributes.width} height={banner.attributes.height} alt={project.imageAlt} />
              </a>
              <div class="preview-head">
                <h2>{project.title}</h2>
                <span class="preview-tag">{project.label}</span>
              </div>
              {project.description && <p class="preview-desc">{project.description}</p>}
              {
                stats && (
                  <ul class="preview-stats">
                    {stats.map((stat) => (
                      <li>
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={stat.icon} />
                        {stat.value} {stat.label}
                      </li>
                    ))}
                  </ul>
                )
              }
              <div class="preview-foot">
                {project.stack.map((item) => <span class="preview-stack">{item}</span>)}
                <span class="preview-spacer"></span>
                <a class="preview-btn preview-repo" href={project.repoUrl} target="_blank" rel="noopener">Repo &#8599;</a>
                {project.liveUrl && <a class="preview-btn preview-live" href={project.liveUrl} target="_blank" rel="noopener">Live &#8599;</a>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
    <div class="files-status">
      <span>{projects.length} projects</span>
      <span id="selected-project">{first.title} selected</span>
    </div>
  </section>
  </div>
</div>