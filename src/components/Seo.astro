---
import { AUTHOR, DEFAULT_DESCRIPTION, SITE_NAME, SOCIAL_TITLE } from '../config';

interface Props {
  title: string;
  description?: string;
}

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://brandonarmand.com');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/og-image.png', siteUrl).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={pageUrl} />
<meta name="author" content={AUTHOR} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={pageUrl} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Brandon Armand Welsh, Software Engineer in New York City" />
<meta property="og:title" content={SOCIAL_TITLE} />
<meta property="og:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#342e3d" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
