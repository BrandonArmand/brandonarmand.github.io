---
import { skills } from '../data/skills';
---

<ul id="skills" aria-label="Skills">
  {
    skills.map((skill) => (
      <li class={`skill ${skill.tier}`}>
        {skill.href ? (
          <a class="skill-text" href={skill.href} target="_blank" rel="noopener">
            {skill.name}
          </a>
        ) : (
          <span class="skill-text">{skill.name}</span>
        )}
      </li>
    ))
  }
</ul>
