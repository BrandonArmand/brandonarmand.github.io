---
import { LOCATION, LOCATION_SHORT, ROUTES } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || ROUTES.home;
const page = path === ROUTES.home ? 'about' : path.replace(/^\//, '');
---

<header class="status-bar" transition:persist="status-bar">
  <div class="pill">
    <strong>brandon</strong>
    <span class="pill-slash">/</span>
    <span class="pill-mono">{page}</span>
  </div>
  <div class="pill pill-place">
    <span class="pill-location">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="11" r="3"></circle>
        <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"></path>
      </svg>
      <span class="location-long">{LOCATION}</span>
      <span class="location-short">{LOCATION_SHORT}</span>
    </span>
    <time class="pill-clock" data-clock>--:--</time>
  </div>
</header>
