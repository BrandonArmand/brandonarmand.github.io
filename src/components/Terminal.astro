---
import { wallFiles } from '../data/profile';
import Welcome from './Welcome.astro';
---

<div class="desk">
  <div class="term-slot">
    <section class="term-window" id="term-window" aria-label="Terminal">
      <div class="toolbar" id="toolbar">
        <button class="red" type="button" aria-label="Close terminal"></button>
        <button class="yellow" type="button" aria-label="Minimize terminal to the dock"></button>
        <button class="green" type="button" aria-label="Zoom terminal"></button>
        <span class="window-title">welcome.js</span>
      </div>
      <div class="console" id="console">
        <p class="intro-line"><span class="prompt-arrow">&gt;</span> node welcome.js</p>
        <Welcome />
        <div class="stack" id="stack"></div>
        <div class="prompt-line">
          <span class="prompt-sign">$</span><span class="input" id="input"></span><span class="caret"></span><span id="autofill-suggestion"></span>
        </div>
      </div>
    </section>
  </div>
  <ul class="wall-files">
    {
      wallFiles.map((file) => (
        <li>
          <button class="wall-file" type="button" data-cmd={`node ${file.name}`}>
            <span class="file-icon" aria-hidden="true">
              <span class="file-fold"></span>
              <span class="file-ext" style={`background: ${file.color}`}>.js</span>
            </span>
            <span class="file-name">{file.name}</span>
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script is:inline>
  try {
    if (sessionStorage.getItem('intro')) document.getElementById('console').classList.add('seen');
  } catch (error) {}
</script>