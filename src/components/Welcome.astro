---
import { GITHUB_URL, LINKEDIN_URL, MAILTO } from '../config';
import { commandChips, exploring, worksWith } from '../data/profile';
---

<div class="welcome" id="welcome">
  <p class="summary">
    <span class="hello">Hello world!</span> I am a Software and Systems Engineer in
    <span class="place">New York City</span>, building <span class="chip chip-dkex">DKeX</span> at
    <span class="chip chip-dk">DraftKings</span>. <span class="chip chip-dkex">DKeX</span> began as
    <span class="chip chip-rb">Railbird Exchange</span>, a <span class="chip chip-yc">YC 22</span> startup, where I was a
    founding engineer and Head of Engineering through its acquisition.
  </p>
  <dl class="profile">
    <dt>works with</dt>
    <dd class="tags">
      {worksWith.map((tag) => <span class="tag"><span class="tag-dot" style={`background: ${tag.dot}`}></span>{tag.name}</span>)}
    </dd>
    <dt>exploring</dt>
    <dd class="tags">
      {exploring.map((tag) => <span class="tag tag-soon"><span class="tag-dot" style={`background: ${tag.dot}`}></span>{tag.name}</span>)}
    </dd>
    <dt>find me</dt>
    <dd class="find">
      <a class="find-blue" href={LINKEDIN_URL} target="_blank" rel="noopener">linkedin &#8599;</a>
      <a class="find-green" href={GITHUB_URL} target="_blank" rel="noopener">github &#8599;</a>
      <a class="find-pink" href={MAILTO}>email &#8599;</a>
    </dd>
  </dl>
  <p class="hint-line">I am a semi-functional terminal. Type a command, or tap one:</p>
  <div class="cmd-chips">
    {commandChips.map((command) => <button class="cmd-chip" type="button" data-cmd={command}>{command}</button>)}
  </div>
</div>