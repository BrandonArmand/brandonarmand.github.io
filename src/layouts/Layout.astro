---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/sidebar.css';
import '../styles/chrome.css';
import '../styles/terminal.css';
import '../styles/projects.css';
import '../styles/history.css';
import Analytics from '../components/Analytics.astro';
import Dock from '../components/Dock.astro';
import Header from '../components/Header.astro';
import Preload from '../components/Preload.astro';
import Seo from '../components/Seo.astro';
import StatusBar from '../components/StatusBar.astro';
import WallFiles from '../components/WallFiles.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
    <Preload />
    <Analytics />
    <script is:inline>
      document.startViewTransition = undefined;
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#home">Skip to content</a>
    <div class="row">
      <Header />
      <div class="col-body" id="body">
        <div class="header-body-divider"></div>
        <div class="body-container">
          <StatusBar />
          <div class="stage">
            <main id="home" tabindex="-1">
              <slot />
            </main>
            <WallFiles />
          </div>
          <Dock />
        </div>
      </div>
    </div>
    <div class="screen-dots" aria-hidden="true"><span></span><span></span></div>
  </body>
</html>

<script>
  import '../scripts/main';
</script>
