---
import { ClientRouter } from 'astro:transitions';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/sidebar.css';
import '../styles/chrome.css';
import '../styles/terminal.css';
import '../styles/projects.css';
import Analytics from '../components/Analytics.astro';
import Dock from '../components/Dock.astro';
import Header from '../components/Header.astro';
import Preload from '../components/Preload.astro';
import Seo from '../components/Seo.astro';
import StatusBar from '../components/StatusBar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
    <Preload />
    <Analytics />
    <ClientRouter />
  </head>
  <body>
    <div class="row">
      <Header />
      <div class="col-body" id="body">
        <div class="header-body-divider"></div>
        <div class="body-container">
          <StatusBar />
          <main id="home">
            <slot />
          </main>
          <Dock />
        </div>
      </div>
    </div>
    <div class="screen-dots" aria-hidden="true"><span></span><span></span></div>
  </body>
</html>

<script>
  import '../scripts/main';
</script>
