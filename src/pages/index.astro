---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import binari from '../assets/binari.png';
import markItOff from '../assets/mark-it-off.png';
import textToSpeech from '../assets/text-to-speech.jpeg';
import taskApi from '../assets/task-api.jpeg';

const binariBanner = await getImage({ src: binari, format: 'webp', width: 1400 });
---

<Layout
  title="Welcome | Brandon Armand"
  description="Software Engineer (formerly Meta) with 5+ years of professional experience writing code."
  home
>
  <main id="home">
    <div id="about">
      <div class="toolbar" id="toolbar">
        <button class="red" type="button" aria-label="Close terminal"><i class="fa-solid fa-xmark"></i></button>
        <button class="yellow" type="button" aria-label="Minimize terminal"><i class="fa-solid fa-minus"></i></button>
        <button class="green" type="button" aria-label="Restore terminal"><i class="fa-solid fa-compress"></i></button>
      </div>
      <div class="console" id="console">
        <div id="intro">
          <p class="helloWorld display-4"><span id="init-input">$</span> node welcome.js</p>
        </div>
        <div class="my-info initial" id="welcome">
          <h3 class="display-4 font delay-init">
            "<span class="text-highlight loud-text" style="color: whitesmoke"><strong>Hello world!</strong></span> I am a highly
            experienced and passionate Software and Systems Engineer residing in
            <span class="text-highlight" style="color: #bedbf3">New York City</span>."
            <br /><br />

            "Currently at
            <span style="color: #8888f0; white-space: nowrap"><strong style="color: #f26522 !important; text-align: left"><i class="fa-brands fa-y-combinator"></i><span style="font-weight: bold; font-size: 14px; letter-spacing: 0.05em; margin-left: -1px; margin-right: 4px">22</span></strong><strong>Railbird</strong></span>,
            and formerly
            <span style="color: #1d65c1; white-space: nowrap"><strong><i class="fa-brands fa-meta" style="margin-right: 5px"></i>Meta</strong></span>,
            I primarily develop with <span class="text-highlight" style="color: #b0e6b8">Python</span> or
            <span class="text-highlight" style="color: #b0e6b8">Typescript</span>, but have current interest in
            <span class="google">
              <span style="color: #4285f4">G</span><span style="color: #ea4335">o</span><span style="color: #fbbc05">o</span><span style="color: #4285f4">g</span><span style="color: #34a853">l</span><span style="color: #ea4335">e</span>'s
            </span>
            <span class="text-highlight" style="color: #b0e6b8">Go-lang</span>
            and <span class="text-highlight" style="color: #b0e6b8">Rust</span>."
            <br /><br />

            "<a class="text-highlight" style="color: orange" href="https://github.com/BrandonArmand/Binari" target="_blank" rel="noopener">Binari</a>
            is my current passive open-source project. If you would like to learn more, I urge you to check out my past
            <a class="text-highlight" style="color: #f2918d" href="#projects" data-goto="projects">Projects</a>,
            <a class="text-highlight" style="color: #f2918d" href="https://www.linkedin.com/in/brandonarmand/" target="_blank" rel="noopener">LinkedIn</a>,
            or <a class="text-highlight" style="color: #f2918d" href="https://github.com/BrandonArmand" target="_blank" rel="noopener">Github</a>.
            You can also <a class="text-highlight" style="color: #f2918d" href="/contact">email me here!</a>"
            <br /><br />

            "I am a semi-functional terminal with autocomplete, try out all my features!"
            <br />
            <span class="code-snippet" data-cmd="help">&gt; help</span><span id="mobile-hint">(On mobile? This is a button)</span>
            <br /><br />

            <span style="color: #bedbf3">└</span>[∵<span style="color: #bedbf3">┌</span>]<span style="color: #b0e6b8">└</span>[ ∵ ]<span style="color: #b0e6b8">┘</span>[<span style="color: orange">┐</span>∵]<span style="color: orange">┘</span>
          </h3>
        </div>
        <div class="stack" id="stack"></div>
        <div style="width: fit-content">
          <p class="blink display-4">$<span class="input" id="input"></span></p><span id="autofill-suggestion" class="display-4"></span>
        </div>
      </div>
    </div>

    <div class="projects" id="projects" hidden>
      <h2>Current Project</h2>
      <div class="current-project">
        <div class="project-corner">
          <a class="project-github" href="https://github.com/BrandonArmand/Binari" target="_blank" rel="noopener" aria-label="Binari on GitHub">
            <i class="fa-brands fa-github"></i>
          </a>
          <h2 class="project-title">BINARI.DEV</h2>
        </div>
        <a href="https://binari.dev" target="_blank" rel="noopener" class="banner" aria-label="Binari" style={`background-image: url(${binariBanner.src})`}></a>
        <div class="info">
          <div class="stats">
            <div class="stat">
              <div class="stat-value"><i class="fa-solid fa-code-fork"></i><span>99 +</span></div>
              <p class="stat-label">FORKS</p>
            </div>
            <div class="stat">
              <div class="stat-value"><i class="fa-solid fa-users"></i><span>25 +</span></div>
              <p class="stat-label">CONTRIBUTORS</p>
            </div>
            <div class="stat">
              <div class="stat-value"><i class="fa-solid fa-star"></i><span>160 +</span></div>
              <p class="stat-label">STARS</p>
            </div>
          </div>
          <p class="project-desc">
            Interactive code editor with a live binary tree visual designed to teach new developers the fundamentals of
            data structures. ~120 - ~150 Monthly visitors.
          </p>
        </div>
      </div>

      <h2 class="deprecated-heading">- - Deprecated Projects - -</h2>
      <ProjectCard
        title="Mark it Off"
        tech="Ruby on Rails"
        href="https://github.com/BrandonArmand/to-do-list"
        image={markItOff}
      />
      <ProjectCard
        title="Text-to-Speech-to-Text CLI"
        tech="Python"
        href="https://github.com/BrandonArmand/Text-to-Speech-to-Text#text-to-speech-with-python"
        image={textToSpeech}
      />
      <ProjectCard
        title="Task-Management API"
        tech="Ruby on Rails"
        href="https://github.com/BrandonArmand/To-do-API#task-managmenet-api"
        image={taskApi}
      />
    </div>
  </main>
</Layout>

<script>
  import '../scripts/home';
</script>
